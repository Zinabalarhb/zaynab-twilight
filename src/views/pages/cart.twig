{#
| Variable                                          | Type                | Description                                                    |
|-----------------------------------------------------|---------------------|-----------------------------------------------------------------|
| page                                                | object              |                                                                 |
| cart                                                | Cart                |                                                                 |
| cart.items                                          | CartItem[]          |                                                                 |
| cart.sub_total / cart.total / cart.discount / etc.  | float               | see original Salla cart object reference                       |
#}
{% extends "layouts.master" %}
{% block content %}
    <div class="container">
        <nav class="breadcrumbs w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
        <h1 class="zaynab-cart-title">{{ trans('blocks.header.cart') }}</h1>
        <salla-conditional-offer></salla-conditional-offer>

        <div class="pt-5 flex flex-col items-start lg:flex-row pb-6 lg:pb-20">
            <div class="main-content w-full lg:w-[calc(100%-384px)]">
                {% hook 'cart:items.start' %}

                {% for item in cart.items %}
                    <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}">
                        <section class="zaynab-cart-item relative">
                            <input type="hidden" name="id" value="{{ item.id }}">

                            <div class="md:flex rtl:space-x-reverse md:space-x-12 items-start justify-between mb-8 last:mb-0">
                                <div class="flex flex-1 rtl:space-x-reverse space-x-4">
                                    <a href="{{ item.url }}" class="zaynab-cart-item__img-wrap relative overflow-hidden shrink-0">
                                        <img src="{{ item.product_image }}"
                                             alt="{{ item.product_name }}"
                                             loading="{{ loop.first ? 'eager' : 'lazy' }}"
                                             class="zaynab-cart-item__img object-center object-cover">

                                        <div class="free-ribbon absolute top-[11px] rtl:right-[-38px] ltr:left-[-38px] w-32 bg-secondary text-white text-xs font-bold text-center py-1 rotate-45 shadow-md {{ (item.price.getMoney().amount == 0 and item.has_discount) ? '' : 'hidden' }}">
                                            {{ trans('pages.loyalty_program.free_product') }}
                                        </div>
                                    </a>
                                    <div class="space-y-1">
                                        <h2 class="zaynab-cart-item__name">
                                            <a href="{{ item.url }}">{{ item.product_name }}</a>
                                        </h2>

                                        <span class="zaynab-cart-item__price-old {{ item.offer ? '' : 'hidden' }}">{{ item.product_price|money }}</span>
                                        <span class="zaynab-cart-item__price-old {{ item.is_on_sale ? '' : 'hidden' }}" id="original_price">{{ item.original_price|money }}</span>
                                        <span class="zaynab-cart-item__price {{ item.has_discount ? 'has-discount' : '' }}" id="has_discount">{{ item.price|money }}</span>

                                        <p class="zaynab-cart-item__weight-row {{ item.weight_label ? '' : 'hidden' }}">
                                            {{ trans('pages.products.weight') }}
                                            <span class="item-weight">{{ item.weight_label }}</span>
                                        </p>

                                        <span class="old-offers flex items-center gap-1 mx-1.5 {{ item.detailed_offers ? 'hidden' : '' }}">
                                            <i class="sicon-discount-calculator text-gray-500 offer-icon {{ item.offer ? '' : 'hidden' }}"></i>
                                            <span class="text-sm text-gray-500 offer-name {{ item.offer ? '' : 'hidden' }}">{{ item.offer.names }}</span>
                                        </span>

                                        <salla-cart-item-offers
                                            quantity="{{ item.quantity }}"
                                            item-id="{{ item.id }}"
                                            product-price="{{ item.product_price }}"
                                            offers="{{ item.detailed_offers|json_encode }}"></salla-cart-item-offers>
                                    </div>
                                </div>

                                <div class="zaynab-cart-item__controls border-t border-b md:border-none mt-5 md:mt-0 flex gap-8 justify-between items-center md:items-start">
                                    {% if item.type == 'donating' %}
                                        <span></span>
                                    {% elseif item.is_hidden_quantity %}
                                        <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="Quantity"/>
                                        <span class="w-10 text-center">{{ item.quantity }}</span>
                                    {% else %}
                                        <salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}"
                                            class="zaynab-qty-input"
                                            aria-label="Quantity"
                                            value="{{ item.quantity }}" name="quantity">
                                        </salla-quantity-input>
                                    {% endif %}
                                    {% set item_total = item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money %}
                                    <p class="zaynab-cart-item__total">
                                        <span>{{ trans('pages.cart.total') }}:</span>
                                        <span class="inline-block item-total">{{ item.is_available ? item_total : trans('pages.cart.out_of_stock') }}</span>
                                    </p>
                                </div>
                            </div>

                            {# Renders size/color chips for this line item via the same
                               shared options partial used on the product page, so a
                               "مقاس M / كحلي" line appears consistently everywhere. #}
                            {% include 'pages.partials.product.options' with { product: item } %}

                            <span class="zaynab-cart-item__remove absolute top-1.5 rtl:left-1.5 ltr:right-1.5">
                                <salla-button type="button" shape="icon" size="small" color="danger" class="btn--delete" aria-label="Remove from the cart"
                                        onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
                                    <i class="sicon-cancel"></i>
                                </salla-button>
                            </span>
                        </section>
                    </form>
                {% else %}
                    <div class="zaynab-cart-empty no-content-placeholder">
                        <i class="sicon-shopping-bag icon"></i>
                        <p>{{ trans('pages.cart.empty_cart') }}</p>
                        <a href="{{ link('/') }}" class="btn btn--outline-gold">{{ trans('common.elements.back_home') }}</a>
                    </div>
                {% endfor %}

                {% if cart.options|length %}
                    <div class="cart-options">
                        {% for product_option in cart.options %}
                            <form class="first:pt-5 relative" onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ product_option.id }}">
                                <input type="hidden" name="id" value="{{ product_option.id }}">
                                <input type="hidden" name="quantity" value="{{ product_option.quantity }}">
                                {% include 'pages.partials.product.options' with { product: product_option } %}
                            </form>
                        {% endfor %}
                    </div>
                {% endif %}

                <salla-offer></salla-offer>

                {% hook 'cart:items.end' %}
            </div>

            {% hook 'cart:summary.start' %}

            {% if cart.items|length %}
                <div class="zaynab-cart-sidebar sticky top-24 w-full lg:w-96 rtl:lg:mr-8 ltr:lg:ml-8">

                    <div class="zaynab-shipping-bar {{ cart.free_shipping_bar ? '' : 'hidden' }}" id="free-shipping">
                        <div class="flex rtl:space-x-reverse space-x-3 items-center">
                            <i class="sicon-shipping-fast {{ theme.is_rtl ? 'flip-x' : '' }}"></i>
                            {% set is_free = cart.free_shipping_bar.has_free_shipping %}
                            <div class="flex-1">
                                <h4 class="zaynab-shipping-bar__title">{{ trans('pages.cart.free_shipping') }}</h4>
                                <p class="zaynab-shipping-bar__msg">
                                    <span id="free-shipping-msg">{{ (is_free
                                        ? trans('pages.cart.has_free_shipping')
                                        : trans('pages.cart.free_shipping_alert', {'amount': cart.free_shipping_bar.remaining|money}))
                                        | raw }}</span>
                                    <span class="emoji {{ is_free ? '' : 'hidden' }}" id="free-shipping-applied">✦</span>
                                </p>
                            </div>
                        </div>
                        <div class="zaynab-shipping-bar__track {{ is_free ? ' hidden' : '' }}" id="free-shipping-bar">
                            <div class="zaynab-shipping-bar__fill" style="width:{{ cart.free_shipping_bar.percent }}%"></div>
                        </div>
                    </div>

                    {% if loyalty %}
                        <salla-loyalty-panel
                            prize-points='{{ loyalty.prize.points }}'
                            prize-title='{{ loyalty.prize.title }}'>
                        </salla-loyalty-panel>
                    {% endif %}

                    <div id="cart-gifting" class="zaynab-cart-card {{ gift.enabled ? '' : 'hidden' }}">
                        <salla-gifting id="salla-gifting" widget-title="{{ trans('pages.cart.gift_widget_title') }}" widget-subtitle="{{ gift.text }}" {{ gift.type }}-products vertical></salla-gifting>
                    </div>

                    <div class="zaynab-cart-summary zaynab-cart-card">
                        <h2 class="zaynab-cart-summary__title">{{ trans('pages.cart.summary') }}</h2>

                        <div class="zaynab-summary-line">
                            <span>{{ trans(cart.tax_amount ? "pages.cart.items_total_without_tax" : "pages.cart.items_total") }}</span>
                            <b id="sub-total">{{ cart.sub_total|money }}</b>
                        </div>

                        {% if cart.options|length %}
                            <div class="zaynab-summary-line">
                                <span>{{ trans('pages.cart.order_options_total') }}</span>
                                <b id="cart-options-total">{{ cart.options_total|money }}</b>
                            </div>
                        {% endif %}

                        <div id="shipping-cost" class="zaynab-summary-line {{ cart.has_shipping ? '' : 'hidden' }}">
                            <span>{{ trans('pages.cart.shipping_cost') }}</span>
                            <b>{{ cart.real_shipping_cost|money }}</b>
                        </div>

                        {% if store.settings.cart.apply_coupon_enabled %}
                            <div class="zaynab-coupon-wrap">
                                <salla-cart-coupons></salla-cart-coupons>
                            </div>
                        {% endif %}

                        <div id="total-discount" class="zaynab-summary-line is-discount {{ cart.total_discount ? '' : 'hidden' }}">
                            <span>{{ trans('pages.cart.discount') }}</span>
                            <b>- {{ cart.total_discount|money }}</b>
                        </div>

                        {% if cart.tax_amount %}
                            <div class="zaynab-summary-line">
                                <span>{{ trans('pages.cart.VAT_tax_amount') }}</span>
                                <b id="tax-amount">{{ cart.tax_amount|money }}</b>
                            </div>
                        {% endif %}

                        <div class="zaynab-summary-total">
                            <span>{{ trans('pages.cart.final_total') }}</span>
                            <b data-cart-total>{{ cart.total|money }}</b>
                        </div>

                        <div class="cart-submit-wrap">
                            {% hook 'cart:submit.start' %}
                            <salla-button id="cart-submit" loader-position="center" width="wide">
                                {{ trans('pages.cart.complete_order') }}
                            </salla-button>
                            {% hook 'cart:submit.end' %}
                        </div>
                        {% hook 'cart:summary.end' %}
                    </div>

                    <salla-tiered-offer></salla-tiered-offer>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
